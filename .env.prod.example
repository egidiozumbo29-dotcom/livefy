# Valori minimi da copiare in `.env` accanto a `docker-compose.prod.yml`
# Comando: docker compose -f docker-compose.prod.yml --env-file .env up --build -d
#
# GENERA I SEGRETI CON:
#   node -e "const c=require('node:crypto');console.log(c.randomBytes(48).toString('hex'));"

# ============================================================
# SEGRETI (OBBLIGATORI — cambia TUTTI prima di andare online)
# ============================================================
POSTGRES_PASSWORD=<genera-con-node-crypto>
HUB_POSTGRES_PASSWORD=<genera-con-node-crypto>
JWT_SECRET=<genera-con-node-crypto-96-hex-chars>
OWNER_INGEST_TOKEN=<genera-con-node-crypto-96-hex-chars>  # identico in API e Hub
OWNER_HUB_SECRET=<genera-con-node-crypto-64-hex-chars>

# ============================================================
# DOMINI (sostituisci con i tuoi domini reali)
# ============================================================
NEXT_PUBLIC_API_URL=https://api.livefy.tuodominio.com/api
NEXT_PUBLIC_WS_URL=https://api.livefy.tuodominio.com
CORS_ORIGIN=https://livefy.tuodominio.com
SOCKET_CORS_ORIGIN=https://livefy.tuodominio.com
FRONTEND_URL=https://livefy.tuodominio.com
OWNER_HUB_URL=https://hub.tuodominio.com

# ============================================================
# OWNER HUB
# ============================================================
OWNER_ALLOWED_EMAILS=egidiozumbo29@gmail.com
OWNER_PLATFORM_ID=livefy
OWNER_PLATFORM_NAME=Livefy

# ============================================================
# LIVEKIT (live streaming video)
# Crea il progetto su https://cloud.livekit.io
# ============================================================
LIVEKIT_URL=wss://<tuo-progetto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================================
# REVOLUT (pagamenti token)
# API key da https://merchant.revolut.com -> Settings -> API
# ============================================================
REVOLUT_API_BASE_URL=https://merchant.revolut.com
REVOLUT_API_KEY=
REVOLUT_API_VERSION=2024-09-01

# ============================================================
# SMTP (email magic link hub)
# Gmail: crea App Password su https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=egidiozumbo29@gmail.com
SMTP_PASS=<app-password-16-chars>
SMTP_FROM=Owner Hub <egidiozumbo29@gmail.com>

# ============================================================
# CONFIGURAZIONE PIATTAFORMA
# ============================================================
PLATFORM_TIP_FEE_PERCENT=30
TOKEN_EUR_RATE=0.05
MODEL_PAYOUT_WITHHOLD_PERCENT=40
MIN_PAYOUT_TOKENS=

# ============================================================
# REDIS (opzionale — abilita cache presenze)
# ============================================================
REDIS_URL=
