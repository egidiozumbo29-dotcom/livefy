# Copia in `apps/web/.env.local` per sviluppo.

# Dove gira Nest (rewrite + fetch lato server). Stesso PC:
API_INTERNAL_ORIGIN=http://127.0.0.1:4000

# Socket.IO (host API, senza /api). Da telefono in LAN usa http://TUO_PC_IP:4000
NEXT_PUBLIC_WS_URL=http://127.0.0.1:4000

# Opzione A — consigliata in dev: NON impostare (o vuoto): il browser chiama `/_nestjs/...`
# e Next inoltra a Nest → niente CORS, funziona anche se apri il sito come http://IP:4321

# Opzione B — fetch diretto al Nest:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
