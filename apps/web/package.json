{
  "name": "synthra-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev -p 3000",
    "dev:fresh": "npm run clean && next dev -p 3000",
    "dev:turbo": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "node .next/standalone/apps/web/server.js",
    "check": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.10",
    "@livekit/components-styles": "^1.1.4",
    "@reduxjs/toolkit": "^2.5.0",
    "framer-motion": "^11.15.0",
    "livekit-client": "^2.6.0",
    "next": "^15.1.6",
    "next-intl": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
