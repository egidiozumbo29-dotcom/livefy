# Copia in `apps/api/.env` per sviluppo locale. Non committare `.env`.

NODE_ENV=development
PORT=4000

# Postgres (es. docker compose dev: localhost:5434)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/livefy?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5434/livefy?schema=public"

JWT_SECRET=change_me_to_a_long_random_string

# REST CORS (browser) — origini separate da virgola
CORS_ORIGIN=http://localhost:3000
# Socket.IO (senza /api)
SOCKET_CORS_ORIGIN=http://localhost:3000

# Fee piattaforma (0–90) su tip, show e acquisti galleria
PLATFORM_TIP_FEE_PERCENT=50

# URL del frontend (redirect Stripe Checkout)
FRONTEND_URL=http://localhost:3000

# LiveKit (streaming) — obbligatorio per live reali; per OBS serve Ingress abilitato sul progetto LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dopo "Vai live", POST /api/streams/ingress/obs crea URL + stream key RTMP per OBS (stessa stanza dei viewer).

# Opzionale — cache
REDIS_URL=

# Pagamenti — opzionale in dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payout — minimo token (opzionale)
MIN_PAYOUT_TOKENS=
