# Owner Hub (Next.js standalone) — build dal root del monorepo.
# docker build -f deploy/Dockerfile.hub -t owner-hub:latest \
#   --build-arg OWNER_HUB_URL=https://hub.tuodominio.com .

FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/owner-hub/package.json apps/owner-hub/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci

COPY apps/owner-hub ./apps/owner-hub

ARG OWNER_HUB_URL=http://localhost:3100
ENV OWNER_HUB_URL=$OWNER_HUB_URL

WORKDIR /app/apps/owner-hub
RUN npx prisma generate --schema=prisma/schema.prisma
WORKDIR /app
RUN npm run build -w owner-hub

FROM node:22-bookworm-slim AS runner
WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3100

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/owner-hub/public ./apps/owner-hub/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/owner-hub/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/owner-hub/.next/static ./apps/owner-hub/.next/static
COPY --from=builder /app/apps/owner-hub/prisma ./apps/owner-hub/prisma
COPY --from=builder /app/apps/owner-hub/generated ./apps/owner-hub/generated

COPY deploy/entrypoint-hub.sh /entrypoint-hub.sh
RUN chmod +x /entrypoint-hub.sh

USER nextjs
EXPOSE 3100
ENTRYPOINT ["/entrypoint-hub.sh"]
